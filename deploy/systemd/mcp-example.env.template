# Environment of the mcp-example service: copy to /etc/mcp-example/mcp-example.env (root:mcp, 0640).
# The real file is never committed. Prefer rendering it from the secrets store at deploy time.
# No backend credential here: the gateway sends the user's credential with every call (C3).

# mTLS: this server's certificate (CN mcp-example, SAN mcp-example.internal, serverAuth and clientAuth) and the internal CA, both PKCS12.
MCP_TLS_KEYSTORE=/etc/mcp-example/tls/keystore.p12
MCP_TLS_TRUSTSTORE=/etc/mcp-example/tls/truststore.p12
MCP_TLS_STORE_PASSWORD=

# Gateway: JWKS of the internal JWT (C2), served over TLS signed by the internal CA.
MCP_GATEWAY_JWKS_URI=https://mcp-gateway.internal:8443/.well-known/jwks.json

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# The gateway on its internal TLS port: the policy data (scope mapping, allowed clients, emergency overrides) is served over
# mTLS to this server's certificate, so the gateway must know this serverId. MCP_GATEWAY_TLS_NAME only when the certificate
# of the gateway does not carry the host of the address.
MCP_GATEWAY_POLICY_DATA_URL=https://mcp-gateway.internal:8443/internal/v1/policy-data
# MCP_GATEWAY_TLS_NAME=mcp-gateway.internal

# This server as the registry sees it (GET /mcp-manifest); the gateway has its own configured address.
MCP_INTERNAL_URL=https://mcp-example.internal:8443/mcp
MCP_ACCEPTED_CREDENTIAL_TYPES=user-secret

# Backend system API; MCP_EXAMPLE_SSL_BUNDLE only when it needs a non-default trust store.
MCP_EXAMPLE_URL=
# Writes are on for the tested versions of the backend. Set to true only to allow them while the probe cannot read the
# version; a version known to be untested stays read-only whatever this says.
MCP_EXAMPLE_WRITES_ON_UNKNOWN_VERSION=false

# Key of paging cursors: Base64 of at least 32 random bytes (openssl rand -base64 32). The same on every instance.
MCP_PAGING_CURSOR_KEY=

# Redis for one-time jti (ACL user mcp-example, keys jti:mcp-example:*, command SET).
MCP_REDIS_HOST=
MCP_REDIS_PORT=6379
MCP_REDIS_USER=mcp-example
MCP_REDIS_PASSWORD=
