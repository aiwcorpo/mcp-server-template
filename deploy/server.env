# Configuration of the server. Fill in the empty values; "docker compose up -d" starts the server, which refuses to start
# with an incomplete one and says what is missing. Do not commit a filled file.
# No credential of the backend here: the gateway sends the user's credential with every call.

# Password of certs/keystore.p12 and certs/truststore.p12 (one password for both).
MCP_TLS_STORE_PASSWORD=

# The gateway on its internal TLS port: the JWKS of the internal JWT and the policy data (scope mapping, allowed clients,
# emergency overrides). The server asks for the policy data with its own certificate, so the gateway must know this serverId.
MCP_GATEWAY_JWKS_URI=
MCP_GATEWAY_POLICY_DATA_URL=
# Only when the certificate of the gateway does not carry the host of the addresses above:
# MCP_GATEWAY_TLS_NAME=mcp-gateway.internal

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# This server as the registry sees it (the manifest); the gateway has its own configured address.
MCP_INTERNAL_URL=https://mcp-example.internal:8443/mcp
# The types the system allows, the first one is the default; the credential of the server in the gateway must agree.
MCP_ACCEPTED_CREDENTIAL_TYPES=user-secret

# API of the backend system, https; MCP_EXAMPLE_SSL_BUNDLE only for a certificate the JVM does not trust.
MCP_EXAMPLE_URL=

# Key of paging cursors: Base64 of at least 32 random bytes (openssl rand -base64 32). The same on every instance.
MCP_PAGING_CURSOR_KEY=

# Redis for the one-time jti, started by compose.yaml next to the server (ACL user mcp-example, keys jti:mcp-example:*, command SET).
# Choose the password (openssl rand -hex 24); compose.yaml sets MCP_REDIS_HOST.
MCP_REDIS_HOST=
MCP_REDIS_PORT=6379
MCP_REDIS_USER=mcp-example
MCP_REDIS_PASSWORD=
