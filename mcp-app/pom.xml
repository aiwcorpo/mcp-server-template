<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-app: bootstrap and the only deployable artifact (target/mcp-example.jar). Assembles the hexagon
  and registers the tools; tests run the whole server over HTTP behind the TestGateway of mcp-platform-test.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pl.aiwcorpo.mcp.example</groupId>
        <artifactId>mcp-example-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>mcp-app</artifactId>
    <name>mcp-example :: App (bootstrap)</name>
    <properties>
        <manifest.export.skip>true</manifest.export.skip>
    </properties>
    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>mcp-tools</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>mcp-integration</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>pl.aiwcorpo.mcp</groupId><artifactId>mcp-platform-starter</artifactId></dependency>

        <!-- Stands in for the gateway in tests (test JWKS, internal JWTs, C3 headers). Never outside test scope. -->
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-platform-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>mcp-example</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              The manifest to register at the gateway: built from the reviewed commit and the production configuration,
              in the ordinary build (also with -DskipTests), as target/mcp-manifest.json. The template and trial servers
              are outside the SystemId of the contracts, so their manifest would be rejected; new-server.sh turns this on
              for a real system.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>export-manifest</id>
                        <phase>package</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <skip>${manifest.export.skip}</skip>
                            <mainClass>pl.aiwcorpo.mcp.example.app.ManifestExport</mainClass>
                            <arguments><argument>${project.build.directory}/mcp-manifest.json</argument></arguments>
                            <classpathScope>runtime</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
