<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-integration: outbound adapters implementing the ports of mcp-core (REST clients of the backend system).
  The credential for the backend comes from the gateway per request (CredentialContext of the starter);
  this module never holds a secret of its own.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pl.aiwcorpo.mcp.example</groupId>
        <artifactId>mcp-example-parent</artifactId>
        <version>2.0.0</version>
    </parent>
    <artifactId>mcp-integration</artifactId>
    <name>mcp-example :: Integration (outbound adapters)</name>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-platform-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
