<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent/aggregator of the MCP server. Cross-cutting concerns (internal JWT of the gateway, backend
  credential, audit, tool errors, MCP transport) come from mcp-platform-starter and are not duplicated here.
  groupId pl.aiwcorpo.mcp.<system> keeps the modules of different servers apart in the artifact repository;
  new-server.sh sets it. Intra-reactor dependencies use ${project.groupId}, the platform stays pl.aiwcorpo.mcp.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pl.aiwcorpo.mcp.example</groupId>
    <artifactId>mcp-example-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mcp-example :: Parent</name>
    <url>https://github.com/aiwcorpo/mcp-server-example</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/aiwcorpo/mcp-server-example</url>
        <connection>scm:git:https://github.com/aiwcorpo/mcp-server-example.git</connection>
    </scm>

    <!-- Must be the Spring Boot version mcp-platform-starter is built against. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <modules>
        <module>mcp-core</module>
        <module>mcp-application</module>
        <module>mcp-integration</module>
        <module>mcp-tools</module>
        <module>mcp-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mcp-platform.version>3.0.0-beta-14</mcp-platform.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Pins the starter, mcp-platform-test, mcp-contracts and Spring AI for the whole server. -->
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-platform-bom</artifactId>
                <version>${mcp-platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Apache-2.0 asks for LICENSE and NOTICE inside every distributed jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>license-files</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
