<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-application: use cases (plain Java) implementing the inbound ports and calling the outbound ports.
  Depends on mcp-core only; mcp-app turns the services into beans.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pl.aiwcorpo.mcp.example</groupId>
        <artifactId>mcp-example-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>mcp-application</artifactId>
    <name>mcp-example :: Application (use cases)</name>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
