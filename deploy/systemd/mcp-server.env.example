# =============================================================================
# EnvironmentFile example (TEMPLATE) — copy to /etc/mcp-server/mcp-server.env
#   chown root:mcp /etc/mcp-server/mcp-server.env && chmod 0640 it
# DO NOT commit the real file. Prefer a secrets manager/vault that renders this at deploy time.
# =============================================================================

MCP_PROFILE=prod

# TLS is terminated at the nginx gateway — the app needs no keystore/password.

# --- Backend base URL (the outbound adapter calls this) ---
EXAMPLE_BACKEND_BASE_URL=https://backend.internal.aiwcorpo.example

# NOTE: no backend token here. The server forwards each caller's own credential (access token or
# PAT, depending on MCP_AUTH_MODE) and never stores it. Do not put shared service-account tokens here.

# --- How callers authenticate: oauth (default) | pat ---
MCP_AUTH_MODE=oauth

# --- Tool guard policy (required in prod) ---
# Who may call which risk level, per-tool kill switches, confirmation rules. Re-read on change.
# Keep it root-owned and read-only for the service user: whoever can edit it can grant privileges.
MCP_GUARD_POLICY=file:/etc/mcp-server/guard-policy.yml

# --- Identity provider (OIDC) — required when MCP_AUTH_MODE=oauth ---
# The issuer whose access tokens this server accepts, and the audience this server is registered as.
MCP_OIDC_ISSUER=https://login.aiwcorpo.example/realms/corp
MCP_OIDC_AUDIENCE=mcp-server
