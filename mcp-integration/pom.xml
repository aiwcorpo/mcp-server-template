<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-integration — OUTBOUND ADAPTERS.
  Implements the outbound ports declared in mcp-core (e.g. repositories, external API clients).
  Put HTTP clients, DB access, message producers here. Apply timeouts, retries, circuit breakers,
  and outbound TLS trust config. Keep secrets out of code (inject via config/env/vault).
  Depends on mcp-core (ports) + mcp-platform-starter (shared utilities: context, audit, error).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pl.aiwcorpo.mcp.example</groupId>
        <artifactId>mcp-server-seed-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>mcp-integration</artifactId>
    <name>MCP Server :: Integration (outbound adapters)</name>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-platform-starter</artifactId>
        </dependency>
    </dependencies>
</project>
