# Configuration of the server. Fill in the empty values; "docker compose up -d" starts the server, which refuses to start
# with an incomplete one and says what is missing. Do not commit a filled file.
# No credential of the backend here: the gateway sends the user's credential with every call.

# The public key set of the gateway: https://<domain of the platform>/.well-known/mcp-jwks.json (the operator of the platform tells you the domain).
MCP_GATEWAY_JWKS_URI=
# Only when the certificate of the platform comes from a CA that the JVM does not know (deploy/README.md, Install, step 2):
# JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/certs/truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12 -Djavax.net.ssl.trustStorePassword=changeit

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# The types the system allows, the first one is the default; the credential of the server in the gateway must agree.
MCP_ACCEPTED_CREDENTIAL_TYPES=user-secret

# API of the backend system, https; MCP_EXAMPLE_SSL_BUNDLE only for a certificate the JVM does not trust.
MCP_EXAMPLE_URL=

# Certificate of the server port. Leave these out and the server generates a self-signed certificate on its first start into the
# state volume and keeps it; it logs the fingerprint ("event=tls_certificate ... fingerprint=sha256:..."), which the operator compares
# with the one the portal shows before approving the connection. Your own certificate instead, files in certs/ (mounted at /certs):
# MCP_TLS_CERT=/certs/server.crt
# MCP_TLS_KEY=/certs/server.key
# or a PKCS12 keystore with its password:
# MCP_TLS_KEYSTORE=/certs/keystore.p12
# MCP_TLS_STORE_PASSWORD=
# No TLS at all, only inside the Docker network of the platform, and only if the operator allows http for this server:
# MCP_PLAIN_HTTP=true

# Several instances behind a balancer only. They need Redis for the one-time jti (otherwise a token could be used once on each
# instance) and the same Base64 key of the paging cursors (openssl rand -base64 32); the same certificate too (MCP_TLS_CERT, MCP_TLS_KEY).
# MCP_REDIS_HOST=
# MCP_REDIS_PORT=6379
# MCP_REDIS_USER=
# MCP_REDIS_PASSWORD=
# MCP_PAGING_CURSOR_KEY=
