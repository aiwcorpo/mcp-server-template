<?xml version="1.0" encoding="UTF-8"?>
<!--
  Everything to stdout (journald or the container runtime collects it). The audit logger of the starter
  writes one C8 JSON line per event, printed bare so the SIEM can parse the line as is.
  requestId in MDC comes from X-Request-Id (CorrelationIdFilter of the starter).
-->
<configuration>
    <appender name="APP" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{requestId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="AUDIT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="pl.aiwcorpo.mcp.audit" level="INFO" additivity="false">
        <appender-ref ref="AUDIT"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="APP"/>
    </root>
</configuration>
