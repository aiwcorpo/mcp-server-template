<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-stub-backend: a small stand-in for the backend system, to run the server end to end on a workstation or in a
  test stack without a real system. Plain JDK, no dependency on the rest of the server; it is never deployed with it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pl.aiwcorpo.mcp.example</groupId>
        <artifactId>mcp-example-parent</artifactId>
        <version>2.0.0</version>
    </parent>
    <artifactId>mcp-stub-backend</artifactId>
    <name>mcp-example :: Stub backend</name>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>mcp-stub-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>pl.aiwcorpo.mcp.example.stub.StubBackendServer</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
